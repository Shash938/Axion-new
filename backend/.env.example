# ==============================================================================
# Axion Backend Environment Configuration Template
# Copy this file to `.env` for local setup or set variables in deployment env.
# ==============================================================================

APP_NAME="Axion AI Investment Advisor"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# Security & Authentication
REQUIRE_API_KEY=false
API_KEYS="axion-dev-key-12345,axion-production-key-998877"
JWT_SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
JWT_ALGORITHM="HS256"

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=60
MAX_PAYLOAD_SIZE_BYTES=102400
ENABLE_SECURITY_HEADERS=true

# Multi-Factor Authentication
MFA_ENABLED=false
MFA_OTP_EXPIRY_SECONDS=300

# SMTP Server Settings (for sending OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Axion AI <noreply@axion.ai>"

# WebAuthn
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Axion AI Investment Advisor"
WEBAUTHN_ORIGIN="http://localhost:8000"
